# Copy to .env in the repository root. Exported variables override this file.
# Device: use your own Spotify app credentials and the backend host address.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Optional absolute cache path; default: spotify.cache in your home directory.
# SPOTIFY_CACHE_PATH=/home/root/spotify.cache
COPILOBA_SERVER_URL=http://localhost:5000/ask_audio
AUDIO_RECORD_DEVICE=plughw:1,0
# AUDIO_TEMP_DIR=/tmp
# Leave empty to keep the current system audio sink.
AUDIO_SINK=
CAMERA_DEVICE=/dev/video7
RPMSG_DEVICE=/dev/ttyRPMSG0
LIBRESPOT_EXEC=librespot
# LIBRESPOT_CACHE_PATH=/home/root/.cache/librespot
WEATHER_LATITUDE=19.5556
WEATHER_LONGITUDE=-99.2472
WEATHER_CITY="López Mateos"

# Backend host: install requirements-backend.txt, Ollama, and the selected models.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
WHISPER_MODEL=base
# Keep the matching .onnx.json file next to the voice model.
# Use an absolute model path when launching from outside the repository root.
PIPER_VOICE_MODEL=models/es_AR-daniela-high.onnx
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# Optional shared bearer token: set the same nonempty value on board and backend.
# Empty preserves unauthenticated access for a private development setup.
COPILOBA_API_TOKEN=

# Seconds. Whisper's limit includes the first model load/download.
RECORD_TIMEOUT=12
PLAYBACK_TIMEOUT=50
WHISPER_TIMEOUT=60
OLLAMA_TIMEOUT=30
PIPER_TIMEOUT=20
PIPER_LOAD_TIMEOUT=60
SPOTIFY_TIMEOUT=5
# Default: WHISPER_TIMEOUT + OLLAMA_TIMEOUT + PIPER_LOAD_TIMEOUT + PIPER_TIMEOUT + 20.
# ASSISTANT_READ_TIMEOUT=190
MAX_UPLOAD_BYTES=2097152
MAX_RESPONSE_BYTES=2097152
MAX_RECORDING_SECONDS=15
